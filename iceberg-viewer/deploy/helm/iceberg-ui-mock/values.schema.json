{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "auth": {
      "type": "object",
      "properties": {
        "allowAnonymous": {
          "type": "boolean"
        },
        "robotToken": {
          "type": "string"
        },
        "ytUpstream": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretRevision": {
          "type": "string"
        }
      }
    },
    "mockBackend": {
      "type": "object",
      "properties": {
        "sourcesFromConfigMap": {
          "type": "boolean"
        },
        "corsOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[^/?#]+$"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "object",
          "properties": {
            "authentication": {
              "type": "string",
              "enum": [
                "",
                "none",
                "basic"
              ]
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "directDownload": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
